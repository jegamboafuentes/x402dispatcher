# Coinbase Developer Platform credentials
# Create at https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Wallet Secret from Portal → Non-custodial Wallet → Security
# (base64 P-256 key — NOT a MetaMask private key)
CDP_WALLET_SECRET=

# Hard cap before any automated USDC spend (required for safety)
MAX_PRICE_USD=0.01

# Optional: markup in basis points (1000 = 10%)
MARKUP_BPS=1000

# Optional: max Bazaar APIs to warm/cache at startup (1–100)
DISCOVERY_LIMIT=40

# Optional: register one MCP tool per discovered API (default false — use search/route instead)
# EXPOSE_DYNAMIC_BAZAAR_TOOLS=false

# V4 Verified tier thresholds
VERIFIED_MIN_SAMPLES=2
VERIFIED_MIN_SUCCESS_RATE=0.8

# V5 HTTP / Cloud Run
# HOST=0.0.0.0
# PORT=8080
# PUBLIC_BASE_URL=https://402dispatcher.com
# DATA_DIR=/tmp/x402dispatcher-data

# V10 durable SQLite (local file; Cloud Run also mirrors to this GCS bucket)
# GCS_DATA_BUCKET=x402dispatcher-data-experiment-jegf-personal
# GCS_DATA_OBJECT=ledger.sqlite

# Network: development = Base Sepolia testnet, production = Base mainnet (real USDC)
# X402_ENV=production

# V6 inbound paywall (calling agents pay Merchant before proxy spends Treasury)
# INBOUND_PAYWALL=true
# INBOUND_PRICE_USD=0.01
# Optional override for Merchant receive address (defaults to CDP account named Merchant)
# X402_PAY_TO=0x...
# Buyer account name used by npm run test:v6
# BUYER_ACCOUNT_NAME=Buyer
