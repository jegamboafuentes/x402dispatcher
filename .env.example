# Coinbase Developer Platform credentials
# Create at https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Wallet Secret from Portal → Non-custodial Wallet → Security
# (base64 P-256 key — NOT a MetaMask private key)
CDP_WALLET_SECRET=

# Hard cap before any automated USDC spend (required for safety)
MAX_PRICE_USD=0.01

# Optional: markup in basis points (1000 = 10%)
MARKUP_BPS=1000

# Optional: max Bazaar tools to register at startup (1–100)
DISCOVERY_LIMIT=40

# V4 Verified tier thresholds
VERIFIED_MIN_SAMPLES=2
VERIFIED_MIN_SUCCESS_RATE=0.8
